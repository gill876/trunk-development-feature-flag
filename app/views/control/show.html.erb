<main class="control">
  <header class="control__header">
    <div>
      <h1>Flagship Control</h1>
      <p><%= t "control.subtitle" %></p>
    </div>
    <div class="control__actions">
      <nav class="control__lang" aria-label="<%= t "control.language" %>">
        <% { en: "English", ja: "日本語" }.each do |locale, name| %>
          <%= link_to name, root_path(locale: locale), lang: locale, "aria-current": ("true" if I18n.locale == locale) %>
        <% end %>
      </nav>
      <%= button_to t("control.start_demo"), demo_path, class: "button button--secondary", form_class: "inline-form" %>
      <%= button_to t("control.send_bots"), runs_path, class: "button", form_class: "inline-form" %>
    </div>
  </header>

  <% if notice %>
    <p class="control__notice" role="status"><%= notice %></p>
  <% end %>

  <div id="board"><%= render "board", board: @board %></div>
</main>
