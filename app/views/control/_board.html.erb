<% if board.empty? %>
  <section class="panel empty">
    <h2><%= t "board.empty_title" %></h2>
    <p><%= t "board.empty_html", button: t("control.send_bots") %></p>
  </section>
<% else %>
  <p class="control__status">
    <%= t "board.last_run", time: time_ago_in_words(board.last_run_at), clock: l(board.last_run_at, format: "%H:%M:%S") %>
    <% if board.demo_until %>
      <%= t "board.demo_on", time: l(board.demo_until, format: "%H:%M") %>
    <% else %>
      <%= t "board.demo_off" %>
    <% end %>
  </p>

  <section class="tiles">
    <div class="tile">
      <span class="tile__label"><%= t "board.traffic" %></span>
      <span class="tile__value"><%= board.traffic_summary %></span>
    </div>
    <div class="tile">
      <span class="tile__label"><%= t "board.orange" %></span>
      <span class="tile__value"><%= t "board.orange_value", orange: board.orange_count, total: board.bot_count %></span>
    </div>
    <div class="tile">
      <span class="tile__label"><%= t "board.errors" %></span>
      <span class="tile__value"><%= board.error_count.zero? ? t("board.none") : t("board.errors_value", errors: board.error_count, visits: board.recent_visit_count) %></span>
    </div>
    <div class="tile">
      <span class="tile__label"><%= t "board.canary" %></span>
      <span class="tile__value"><%= board.canary_summary %></span>
    </div>
  </section>

  <div class="board-layout">
    <section class="panel grid-panel">
      <div class="legend">
        <span class="legend__item"><span class="cell cell--blue"></span><%= t "board.legend.blue" %></span>
        <span class="legend__item"><span class="cell cell--orange"></span><%= t "board.legend.orange" %></span>
        <span class="legend__item"><span class="cell cell--plain">c</span><%= t "board.legend.canary" %></span>
        <span class="legend__item"><span class="cell cell--error">×</span><%= t "board.legend.error" %></span>
        <span class="legend__note"><%= t "board.legend.note" %></span>
      </div>
      <div class="grid-scroll">
        <table class="grid">
          <tbody>
            <% board.rows.each do |row| %>
              <tr>
                <th scope="row">
                  <span class="avatar avatar--<%= row.cohort %>"><%= row.cohort.first.upcase %><%= row.handle.last(1) %></span>
                  <%= row.handle %>
                </th>
                <td class="grid__cells">
                  <% row.cells.each_with_index do |cell, index| %>
                    <span class="cell cell--<%= cell.state %><%= " cell--gap" if index.positive? && (index % BotSquad::VISITS_PER_BOT).zero? %>" title="<%= cell.title %>"><%= cell.state == "error" ? "×" : ("c" if cell.canary) %></span>
                  <% end %>
                </td>
                <td class="grid__latest"><%= row.latest %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <aside class="panel cohorts">
      <h2><%= t "board.cohorts" %></h2>
      <% board.cohorts.each do |count| %>
        <div class="cohort">
          <div class="cohort__head">
            <span class="swatch swatch--<%= count.cohort %>"></span>
            <b><%= count.cohort.capitalize %></b>
            <span class="cohort__count"><%= t "board.cohort_value", orange: count.orange, total: count.total %></span>
          </div>
          <div class="bar"><div class="bar__fill" style="width: <%= (100 * count.orange / count.total.to_f).round %>%"></div></div>
        </div>
      <% end %>
      <p class="cohorts__note"><%= t "board.cohorts_note" %></p>
    </aside>
  </div>
<% end %>
