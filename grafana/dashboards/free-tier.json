    {
      "type": "timeseries",
      "title": "Billable instance time, by service",
      "description": "Seconds of instance time per hour. Spikes are demo mode, deploys and Grafana sessions.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "gcm"
      },
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "__GOOGLE_CLOUD_PROJECT__",
            "expr": "sum by (service_name) (increase(run_googleapis_com:container_billable_instance_time{monitored_resource=\"cloud_run_revision\"}[$__interval]))",
            "step": "$__interval"
          },
          "timeSeriesList": {
            "projectName": "__GOOGLE_CLOUD_PROJECT__",
            "crossSeriesReducer": "REDUCE_NONE"
          }
        },
        {
          "refId": "B",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "__GOOGLE_CLOUD_PROJECT__",
            "expr": "sum by (job_name) (increase(run_googleapis_com:container_billable_instance_time{monitored_resource=\"cloud_run_job\"}[$__interval]))",
            "step": "$__interval"
          },
