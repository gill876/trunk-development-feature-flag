    {
      "type": "timeseries",
      "title": "Instances, by revision",
      "description": "Cloud Run starts instances when requests arrive and stops them when idle. The store allows 2 at most.",
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "gcm"
      },
      "interval": "2m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "__GOOGLE_CLOUD_PROJECT__",
            "expr": "sum by (revision_name, state) (run_googleapis_com:container_instance_count{monitored_resource=\"cloud_run_revision\",service_name=\"flagship\"})",
            "step": "$__interval"
          },
          "timeSeriesList": {
            "projectName": "__GOOGLE_CLOUD_PROJECT__",
