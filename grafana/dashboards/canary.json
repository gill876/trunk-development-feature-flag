          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "__GOOGLE_CLOUD_PROJECT__",
            "expr": "sum by (revision_name) (increase(run_googleapis_com:request_count{monitored_resource=\"cloud_run_revision\",service_name=\"flagship\"}[$__interval]))",
            "step": "$__interval"
          },
          "timeSeriesList": {
