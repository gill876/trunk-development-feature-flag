    {
      "type": "table",
      "title": "Failed requests (5xx), from Cloud Run's request logs",
      "description": "Which revision answered each one, and to whom. Sentry has the stack traces.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "googlecloud-logging-datasource",
        "uid": "gcl"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "googlecloud-logging-datasource",
            "uid": "gcl"
          },
          "queryText": "resource.type=\"cloud_run_revision\"\nresource.labels.service_name=\"flagship\"\nhttpRequest.status>=500",
          "projectId": "__GOOGLE_CLOUD_PROJECT__"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "timestamp": true,
              "resource.labels.revision_name": true,
              "httpRequest.status": true,
              "httpRequest.request_method": true,
              "httpRequest.request_url": true,
              "httpRequest.latency": true,
              "httpRequest.user_agent": true
            },
            "renameByName": {
              "timestamp": "Time",
              "resource.labels.revision_name": "Revision",
              "httpRequest.status": "Status",
              "httpRequest.request_method": "Method",
              "httpRequest.request_url": "URL",
              "httpRequest.latency": "Latency",
              "httpRequest.user_agent": "User agent"
            },
            "indexByName": {
              "timestamp": 0,
              "resource.labels.revision_name": 1,
              "httpRequest.status": 2,
              "httpRequest.request_method": 3,
              "httpRequest.request_url": 4,
              "httpRequest.latency": 5,
              "httpRequest.user_agent": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
