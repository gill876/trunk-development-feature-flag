    {
      "type": "text",
      "title": "The four golden signals",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Traffic** (how much is asked), **errors** (how much fails), **latency** (how long it takes) and **saturation**\n(how full it is). If you can only watch four things, watch these. Pick the service at the top left.\n"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Requests",
      "description": "In the time range picked at the top right.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "gcm"
      },
      "interval": "5m",
      "maxDataPoints": 50,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "__GOOGLE_CLOUD_PROJECT__",
            "expr": "sum(increase(run_googleapis_com:request_count{monitored_resource=\"cloud_run_revision\",service_name=\"$service\"}[$__interval]))",
            "step": "$__interval"
          },
          "timeSeriesList": {
            "projectName": "__GOOGLE_CLOUD_PROJECT__",
            "crossSeriesReducer": "REDUCE_NONE"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 2
    },
