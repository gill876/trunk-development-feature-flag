{
  "uid": "flagship-slo",
  "title": "SLO: store availability",
  "description": "A service level objective for the store: 99% of requests succeed, over any 7 days. How much error budget is left, and how fast it's burning.",
  "tags": [
    "flagship",
    "sre"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Flagship dashboards",
      "type": "dashboards",
      "tags": [
        "flagship"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "The objective",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**SLI** (what we measure): the share of store requests that don't fail with a 5xx.\n**SLO** (what we promise): **99%** of them succeed, over any 7 days. That leaves an **error budget** of 1%: failures we\ncan afford, and spend on shipping things (a canary that fails 10% of its requests for a few minutes uses some).\n**Burn rate**: how fast the budget goes. 1 spends exactly the budget in 7 days; 14.4 spends it in about 12 hours,\nwhich is when a real team gets paged. The bad-canary drill burns it on purpose. The bots' requests count too.\n"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Availability, last 7 days",
      "description": "Share of store requests that didn't fail with a 5xx.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "gcm"
      },
      "interval": "1h",
      "maxDataPoints": 50,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "__GOOGLE_CLOUD_PROJECT__",
            "expr": "100 * (1 - (sum(rate(run_googleapis_com:request_count{monitored_resource=\"cloud_run_revision\",service_name=\"flagship\",response_code_class=\"5xx\"}[7d])) or vector(0)) / sum(rate(run_googleapis_com:request_count{monitored_resource=\"cloud_run_revision\",service_name=\"flagship\"}[7d])))",
            "step": "$__interval"
          },
          "timeSeriesList": {
            "projectName": "__GOOGLE_CLOUD_PROJECT__",
            "crossSeriesReducer": "REDUCE_NONE"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.5
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 2
    },
